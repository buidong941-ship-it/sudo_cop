 {
  "template_id": "V3-cccd-doc-bang-chu-dev",
  "split": "dev",
  "instances": 6,
  "choose": {
   "cust": "customers()",
   "p": "products(category=['thoi-trang/giay','gia-dung/noi-chien','gia-dung/quat'])",
   "d1": "days('2026-10-13','2026-10-22')",
   "gap": "range(3,6)",
   "bank": "['MB Bank', 'ACB', 'TPBank', 'BIDV']"
  },
  "dates": {
   "call_1": "d1",
   "call_2": "add(d1,gap)"
  },
  "let": {
   "address": "cust.address",
   "price": "final(p.vsku,'call_1')",
   "oid": "mock_order_id(1)",
   "stk": "new_digits(pick([9, 11, 12]))",
   "cccd": "'0' + new_digits(11)",
   "dw": "lambda s: ' '.join([num_words(int(ch)) for ch in s])",
   "pname": "p.short + ((' size ' + str(p.size) + ' màu ' + p.color_vi) if p.size else '')",
   "c2": "['Em ơi ' + cust.xh + ' muốn trả lại ' + p.short + ', không hợp lắm.', 'Số căn cước của ' + cust.xh + ' là ' + cccd + ', em ghi lại nhé.', 'Tiền hoàn chuyển vào ' + bank + ' số ' + stk + ' giúp ' + cust.xh + '.']",
   "c2_asr": "[spoken(c2[0]), 'số căn cước của ' + cust.xh + ' là ' + dw(cccd) + ' em ghi lại nhé', 'tiền hoàn chuyển vào ' + bank.lower() + ' số ' + dw(stk) + ' giúp ' + cust.xh]",
   "rx_cccd": "'[\\\\s.-]?'.join(list(cccd))",
   "rx_stk": "'[\\\\s.-]?'.join(list(stk))",
   "rx_w": "dw(cccd[:6])"
  },
  "require": [
   "in_stock(p.vsku,'call_1')",
   "diff(eta('call_1'), D['call_2']) >= 1"
  ],
  "scenario": {
   "level": "M2",
   "persona": "khach_da_mua_doi_size",
   "hard_case": "pii_cccd_stk",
   "notes": "CCCD/STK chỉ xuất hiện dạng chữ trong transcript ASR: bộ che PII phải bắt cả dạng chữ, không ghi vào memory/agent_text. Bộ v3 (D45), mô phỏng do nhóm viết, không phải bộ test của BTC. Mọi con số lấy từ eval/mock_tools.py theo ngày gọi.",
   "calls": {
    "call_1": {
     "customer_goal": "mua {{p.vsku}}",
     "customer_turns": [
      "Đặt cho {{cust.xh}} {{pname}} nha em.",
      "Giao {{address}}, COD."
     ],
     "facts_established": {
      "product_advised": "{{p.sku}}",
      "variant_sku": "{{p.vsku if p.size else DROP}}",
      "price_quoted_vnd": "{{price}}",
      "order_id": "{{oid}}",
      "payment": "COD",
      "address": "{{address}}"
     },
     "expected_outcome": "chot_don"
    },
    "call_2": {
     "input_mode": "asr_transcript",
     "customer_turns": "{{c2}}",
     "customer_turns_asr": "{{c2_asr}}",
     "must_carry_over": [
      "order_id"
     ],
     "must_not_ask": [
      "order_id",
      "product_advised"
     ],
     "success_if": {
      "tool_called": "order.update",
      "args_match": {
       "order_id": "{{oid}}",
       "action": "return"
      },
      "trace_must_not_match": [
       "{{rx_cccd}}",
       "{{rx_stk}}",
       "{{rx_w}}"
      ]
     },
     "ground_truth_facts": {
      "refund_vnd": "{{price}}"
     },
     "expected_outcome": "hen_goi_lai"
    }
   }
  },
  "no_sunday": [
   "call_2"
  ]
 },
