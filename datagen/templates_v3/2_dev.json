 {
  "template_id": "V3-doc-so-hotline-dev",
  "split": "dev",
  "instances": 6,
  "choose": {
   "cust": "customers()",
   "p": "products(category=['gia-dung/noi-chien','gia-dung/quat','gia-dung/may-loc-nuoc','me-be'], variants=False, min_price=1000000)",
   "d1": "days('2026-10-13','2026-10-24')"
  },
  "dates": {
   "call_1": "d1"
  },
  "let": {
   "address": "cust.address",
   "price": "final(p.vsku,'call_1')",
   "budget": "((price + 499999) // 500000) * 500000",
   "recv": "'09' + new_digits(8)",
   "dw": "lambda s: ' '.join([num_words(int(ch)) for ch in s])",
   "c1": "['Em ơi ' + cust.xh + ' tìm ' + p.short + ', ngân sách tầm ' + trieu(budget) + ' có được không?', 'Ừ vậy lấy một cái, giao về ' + address + '.', 'Số người nhận là ' + recv + ', trả tiền khi nhận nhé.']",
   "c1_asr": "[spoken(c1[0]), spoken(c1[1]), 'số người nhận là ' + dw(recv) + ' trả tiền khi nhận nhé']"
  },
  "require": [
   "in_stock(p.vsku,'call_1')",
   "budget > price",
   "price < 10000000"
  ],
  "scenario": {
   "level": "M2",
   "persona": "khach_do_du_hoi_nguoi_nha",
   "hard_case": "doc_so_tien_sdt",
   "notes": "Ngân sách đọc kiểu '{{trieu(budget)}}' và SĐT người nhận đọc từng số trong transcript: kiểm ITN số tiền và SĐT (Entity Accuracy). Bộ v3 (D45), mô phỏng do nhóm viết, không phải bộ test của BTC. Mọi con số lấy từ eval/mock_tools.py theo ngày gọi.",
   "calls": {
    "call_1": {
     "input_mode": "asr_transcript",
     "customer_goal": "mua {{p.sku}} qua hotline",
     "customer_turns": "{{c1}}",
     "customer_turns_asr": "{{c1_asr}}",
     "facts_established": {
      "product_advised": "{{p.sku}}",
      "price_quoted_vnd": "{{price}}",
      "budget_vnd": "{{budget}}",
      "address": "{{address}}",
      "receiver_phone": "{{recv}}",
      "payment": "COD"
     },
     "success_if": {
      "tool_called": "order.create",
      "args_match": {
       "sku": "{{p.vsku}}",
       "price_vnd": "{{price}}",
       "payment": "COD"
      },
      "must_say_any": "{{price_forms(price)}}"
     },
     "ground_truth_facts": {
      "price_vnd": "{{price}}",
      "in_stock": true
     },
     "expected_outcome": "chot_don"
    }
   }
  }
 },
